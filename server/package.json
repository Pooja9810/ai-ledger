{
  "name": "ledgerly-server",
  "version": "1.0.0",
  "description": "Ledgerly API server",
  "main": "src/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "seed": "node scripts/seed.js",
    "dev:demo": "DB_PATH=demo.db node --env-file-if-exists=.env --watch src/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "openai": "^7.55.0"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
